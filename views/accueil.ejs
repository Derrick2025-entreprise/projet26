<% titre = "Home"; %>
<%- include('layout/header') %>

<div class="hero">
  <h1>🍽️ Ricette d'Europa</h1>
  <p>Scopri, condividi e assapora le migliori ricette di cucina</p>
</div>

<section aria-labelledby="titre-accueil">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 id="titre-accueil">Tutte le ricette</h1>
    <% if (utilisateur) { %>
      <a href="/recettes/nouvelle" class="btn btn-success">+ Nuova ricetta</a>
    <% } %>
  </div>

  <% if (recettes.length === 0) { %>
    <div class="text-center py-5 text-muted">
      <p class="fs-5">Nessuna ricetta per il momento.</p>
      <% if (utilisateur) { %>
        <a href="/recettes/nouvelle" class="btn btn-primary">Pubblica la prima ricetta</a>
      <% } else { %>
        <a href="/inscription" class="btn btn-primary">Registrati per pubblicare</a>
      <% } %>
    </div>
  <% } else { %>
    <ol class="row row-cols-1 row-cols-md-3 g-4 list-unstyled" aria-label="Elenco ricette">
      <% recettes.forEach(recette => { %>
        <li class="col">
          <article class="card h-100">
            <% if (recette.image_url) { %>
              <img src="<%= recette.image_url %>" class="card-img-top" alt="Foto di <%= recette.titre %>">
            <% } else { %>
              <div class="recipe-placeholder" aria-hidden="true">🍴</div>
            <% } %>
            <div class="card-body">
              <h2 class="card-title h5"><%= recette.titre %></h2>
              <p class="card-text text-muted small mb-1">
                Di <strong><%= recette.auteur %></strong>
              </p>
              <% if (recette.description) { %>
                <p class="card-text">
                  <%= recette.description.substring(0, 100) %><%= recette.description.length > 100 ? '…' : '' %>
                </p>
              <% } %>
            </div>
            <div class="card-footer card-footer-recette">
              <%- include('partials/etoiles-carte', {
                recetteId: recette.id,
                noteMoyenne: recette.note_moyenne,
                nbNotations: recette.nb_notations
              }) %>
              <div class="d-flex justify-content-between align-items-center mt-2">
                <a href="/recettes/<%= recette.id %>" class="btn btn-outline-primary btn-sm">
                  Vedi la ricetta
                  <span class="visually-hidden">: <%= recette.titre %></span>
                </a>
                <% if (utilisateur) { %>
                  <button type="button" class="btn btn-favori"
                          data-recette-id="<%= recette.id %>"
                          aria-label="Aggiungi ai preferiti"
                          aria-pressed="false">
                    🤍
                  </button>
                <% } %>
              </div>
            </div>
          </article>
        </li>
      <% }); %>
    </ol>

    <%# Paginazione %>
    <% if (totalPages > 1) { %>
      <nav aria-label="Paginazione ricette" class="mt-5">
        <ul class="pagination justify-content-center">
          <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/?page=<%= page - 1 %>" aria-label="Pagina precedente">
              <span aria-hidden="true">&laquo;</span>
            </a>
          </li>
          <% for (let i = 1; i <= totalPages; i++) { %>
            <li class="page-item <%= i === page ? 'active' : '' %>" <%= i === page ? 'aria-current="page"' : '' %>>
              <a class="page-link" href="/?page=<%= i %>"><%= i %></a>
            </li>
          <% } %>
          <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/?page=<%= page + 1 %>" aria-label="Pagina successiva">
              <span aria-hidden="true">&raquo;</span>
            </a>
          </li>
        </ul>
        <p class="text-center text-muted small"><%= total %> ricett<%= total !== 1 ? 'e' : 'a' %> in totale</p>
      </nav>
    <% } %>
  <% } %>
</section>

<%- include('layout/footer') %>
